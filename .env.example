# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Claude (metadata generation)
ANTHROPIC_API_KEY=

# YouTube Data API v3 — OAuth client (Desktop). The token file is created on first auth.
MILLICLIP_YT_CLIENT_SECRET_FILE=secrets/yt_client_secret.json
MILLICLIP_YT_TOKEN_FILE=secrets/yt_token.json

# Instagram Graph API (Instagram Business account via Facebook Login)
MILLICLIP_IG_ACCESS_TOKEN=
MILLICLIP_IG_USER_ID=

# Health alert webhook (optional)
MILLICLIP_ALERT_WEBHOOK=
